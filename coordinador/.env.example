# Copia a .env y completa. NUNCA subas .env al repositorio. Todos los valores de abajo son ficticios.
GOOGLE_API_KEY=AIza-VALOR-FICTICIO
MODELO=gemini-3.5-flash-lite
# Clave que deben enviar a POST /chat en la cabecera X-API-Key
COORD_API_KEY=clave-coordinador-ficticia-cambiame
# Direcciones públicas de los agentes (separadas por coma) y SUS claves, en el mismo orden
URLS_AGENTES=http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003,http://127.0.0.1:8004
CLAVES_AGENTES=clave-gerardo-ficticia,clave-diego-ficticia,clave-jaime-ficticia,clave-henry-ficticia
# Telegram: token del bot (@BotFather), secreto del webhook (inventa uno) y, opcional, chats autorizados (ids separados por coma)
TELEGRAM_BOT_TOKEN=123456:TOKEN-FICTICIO
TELEGRAM_WEBHOOK_SECRET=secreto-webhook-ficticio
TELEGRAM_CHATS_PERMITIDOS=
